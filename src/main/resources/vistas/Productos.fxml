<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fernandogranados.demo.controlador.ProductosControlador">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <top>
        <Label text="Productos" styleClass="titulo-pantalla">
            <BorderPane.margin>
                <Insets bottom="16.0" />
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox spacing="12">
            <ListView fx:id="listaProductos" styleClass="lista-tarjetas" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Tu carta está vacía. Agrega el primer producto." styleClass="estado-vacio" wrapText="true" /></placeholder>
            </ListView>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="320.0" spacing="12.0" maxHeight="-Infinity" BorderPane.alignment="TOP_RIGHT" styleClass="tarjeta">
            <BorderPane.margin>
                <Insets left="20.0" />
            </BorderPane.margin>
            <children>
                <Label text="Datos del producto" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label text="Categoría" />
                <ComboBox fx:id="comboCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccione una categoría" />
                <Label text="Nombre" />
                <TextField fx:id="campoNombre" promptText="Ej. Café americano" />
                <Label text="Descripción" />
                <TextArea fx:id="campoDescripcion" prefRowCount="3" promptText="Descripción opcional" wrapText="true" />
                <Label text="Precio" />
                <TextField fx:id="campoPrecio" promptText="Ej. 25.00" />
                <CheckBox fx:id="casillaDisponible" mnemonicParsing="false" selected="true" text="Disponible para venta" />
                <HBox spacing="8.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#guardarProducto" styleClass="btn-primary" text="Guardar" />
                        <Button mnemonicParsing="false" onAction="#limpiarFormulario" text="Nuevo" />
                        <Button mnemonicParsing="false" onAction="#eliminarProducto" styleClass="btn-danger" text="Eliminar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </right>
</BorderPane>
