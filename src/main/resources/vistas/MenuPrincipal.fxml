<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="contenedorPrincipal" styleClass="vista" xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fernandogranados.demo.controlador.MenuPrincipalControlador">
    <left>
        <VBox prefWidth="224.0" spacing="6.0" styleClass="barra-lateral">
            <padding>
                <Insets top="24.0" right="16.0" bottom="20.0" left="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <FontIcon iconLiteral="fas-mug-hot" iconSize="22" />
                        <Label styleClass="marca" text="Cafetería" />
                    </children>
                </HBox>
                <Label styleClass="texto-secundario" text="GESTIÓN ESCOLAR" />
                <Separator />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirCategorias" text="Categorías">
                    <graphic><FontIcon iconLiteral="fas-tags" iconSize="16" /></graphic>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirProductos" text="Productos">
                    <graphic><FontIcon iconLiteral="fas-coffee" iconSize="16" /></graphic>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirClientes" text="Clientes">
                    <graphic><FontIcon iconLiteral="fas-users" iconSize="16" /></graphic>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirEmpleados" text="Empleados">
                    <graphic><FontIcon iconLiteral="fas-user-tie" iconSize="16" /></graphic>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirVentas" text="Ventas">
                    <graphic><FontIcon iconLiteral="fas-cash-register" iconSize="16" /></graphic>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirHistorialVentas" text="Historial de ventas">
                    <graphic><FontIcon iconLiteral="fas-receipt" iconSize="16" /></graphic>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirReportes" text="Reportes">
                    <graphic><FontIcon iconLiteral="fas-chart-bar" iconSize="16" /></graphic>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="10.0">
            <padding>
                <Insets top="32.0" right="32.0" bottom="32.0" left="32.0" />
            </padding>
            <children>
                <FontIcon iconLiteral="fas-mug-hot" iconSize="38" />
                <Label fx:id="tituloModulo" styleClass="titulo-pantalla" text="Bienvenido" />
                <Label fx:id="descripcionModulo" styleClass="texto-secundario" text="Seleccione una opción del menú para comenzar." wrapText="true" />
            </children>
        </VBox>
    </center>
</BorderPane>
