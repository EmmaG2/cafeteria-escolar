<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="vista" xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fernandogranados.demo.controlador.ReportesControlador">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <top>
        <VBox spacing="16.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <FontIcon iconLiteral="fas-chart-bar" iconSize="22" />
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="titulo-pantalla" text="Reporte contable" />
                                <Label fx:id="etiquetaPeriodo" styleClass="periodo-contable" text="Período seleccionado · Solo ventas pagadas" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="8.0" styleClass="tarjeta">
                    <children>
                        <Label styleClass="campo-etiqueta" text="CONFIGURAR REPORTE" />
                        <FlowPane hgap="8.0" vgap="12.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="campo-etiqueta" text="Tipo de reporte" />
                                        <ComboBox fx:id="comboTipoReporte" prefWidth="225.0" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="campo-etiqueta" text="Desde" />
                                        <DatePicker fx:id="selectorFechaInicio" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="campo-etiqueta" text="Hasta" />
                                        <DatePicker fx:id="selectorFechaFin" />
                                    </children>
                                </VBox>
                                <Button mnemonicParsing="false" onAction="#cargarReporte" styleClass="btn-primary, boton-icono" text="Generar">
                                    <graphic>
                                        <FontIcon iconLiteral="fas-sync-alt" iconSize="14" />
                                    </graphic>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#exportarPdf" styleClass="btn-success, boton-icono" text="Exportar PDF">
                                    <graphic>
                                        <FontIcon iconLiteral="fas-file-pdf" iconSize="14" />
                                    </graphic>
                                </Button>
                            </children>
                        </FlowPane>
                    </children>
                </VBox>
                <HBox spacing="12.0">
                    <children>
                        <VBox spacing="4.0" styleClass="tarjeta-resumen">
                            <children>
                                <Label text="VENTAS PAGADAS" styleClass="campo-etiqueta" />
                                <Label fx:id="etiquetaNumeroVentas" styleClass="valor-resumen" text="0" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="tarjeta-resumen">
                            <children>
                                <Label text="INGRESOS" styleClass="campo-etiqueta" />
                                <Label fx:id="etiquetaIngresos" styleClass="valor-resumen moneda" text="MXN $0.00" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="tarjeta-resumen">
                            <children>
                                <Label text="TICKET PROMEDIO" styleClass="campo-etiqueta" />
                                <Label fx:id="etiquetaTicketPromedio" styleClass="valor-resumen moneda" text="MXN $0.00" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets bottom="20.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <HBox spacing="16.0">
            <children>
                <VBox prefWidth="400.0" minWidth="350.0" spacing="8.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <FontIcon iconLiteral="fas-list" iconSize="16" />
                                <Label styleClass="titulo-seccion" text="Movimientos del período" />
                            </children>
                        </HBox>
                        <ListView fx:id="listaDatos" VBox.vgrow="ALWAYS" styleClass="lista-tarjetas">
                            <placeholder><Label text="Sin datos para este período." styleClass="estado-vacio" wrapText="true" /></placeholder>
                        </ListView>
                    </children>
                </VBox>
                <VBox fx:id="panelGrafica" spacing="8.0" styleClass="panel-grafica" prefWidth="500" minWidth="250" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <children>
                            <FontIcon iconLiteral="fas-chart-bar" iconSize="16" />
                            <Label styleClass="titulo-seccion" text="Tendencia y distribución" />
                        </children>
                    </HBox>
                    <ImageView fx:id="imagenGrafica" fitHeight="320.0" fitWidth="600.0" preserveRatio="true" />
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
