<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fernandogranados.demo.controlador.VentasControlador">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <top>
        <VBox spacing="12.0">
            <children>
                <Label text="Registrar venta" styleClass="titulo-pantalla" />
                <HBox spacing="8.0">
                    <children>
                        <ComboBox fx:id="comboProducto" prefWidth="310.0" promptText="Seleccione un producto disponible" />
                        <TextField fx:id="campoCantidad" prefWidth="85.0" promptText="Cantidad" />
                        <Button mnemonicParsing="false" onAction="#agregarProducto" styleClass="btn-primary" text="Agregar" />
                        <Button mnemonicParsing="false" onAction="#quitarProducto" styleClass="btn-danger" text="Quitar seleccionado" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets bottom="16.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <Label text="Tu pedido" styleClass="titulo-seccion" />
            <ListView fx:id="listaCarrito" styleClass="lista-tarjetas" VBox.vgrow="ALWAYS">
                <placeholder><Label text="El pedido está vacío. Elige un producto y pulsa Agregar." styleClass="estado-vacio" wrapText="true" /></placeholder>
            </ListView>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="320.0" spacing="12.0" maxHeight="-Infinity" BorderPane.alignment="TOP_RIGHT" styleClass="tarjeta">
            <BorderPane.margin>
                <Insets left="20.0" />
            </BorderPane.margin>
            <children>
                <Label text="Datos de la venta" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label text="Empleado" />
                <ComboBox fx:id="comboEmpleado" maxWidth="1.7976931348623157E308" promptText="Seleccione un empleado" />
                <Label text="Cliente" />
                <ComboBox fx:id="comboCliente" maxWidth="1.7976931348623157E308" promptText="Sin cliente" />
                <Label text="Método de pago" />
                <ComboBox fx:id="comboMetodoPago" maxWidth="1.7976931348623157E308" />
                <Label fx:id="etiquetaTotal" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total: $0" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarVenta" styleClass="btn-success" text="Registrar venta" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiarVenta" text="Limpiar venta" />
            </children>
        </VBox>
    </right>
</BorderPane>
